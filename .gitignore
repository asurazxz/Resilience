# =============================================================================
# Resilience — ignore rules
#
# This repository is published publicly. Anything holding a credential, a
# personal path, or machine-specific state must be listed here.
#
# NOTE: these rules only affect files Git is not already tracking. Adding a
# path here does NOT remove a file that has already been committed — use
# `git rm --cached <path>` for that.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets and credentials — never commit these
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
.netrc
credentials*.json
service-account*.json
secrets/
*.bak

# Private source material shared outside Git
/context/

# -----------------------------------------------------------------------------
# Node / React / Vite
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
build/
coverage/
.nyc_output/
.vite/
.eslintcache
*.tsbuildinfo
stats.html

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Python / FastAPI
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.venv/
.venv*/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

.coverage
.coverage.*
htmlcov/

*.egg-info/
.eggs/

# -----------------------------------------------------------------------------
# Databases and local Supabase state
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.dump
postgres-data/

# Local Supabase CLI working state. Migrations, seed.sql, config.toml and
# tests are tracked; the CLI's own scratch directories are not.
supabase/.branches/
supabase/.temp/

# -----------------------------------------------------------------------------
# Generated and user-supplied data
# -----------------------------------------------------------------------------
uploads/
data/private/
tmp/
logs/
*.log

# -----------------------------------------------------------------------------
# Test and browser output
# -----------------------------------------------------------------------------
playwright-report/
blob-report/
test-results/
.playwright/

# -----------------------------------------------------------------------------
# Deployment platform state
# -----------------------------------------------------------------------------
.vercel/
.netlify/

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
.history/
*.code-workspace
*.swp
*.swo

# -----------------------------------------------------------------------------
# Operating systems
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# AI agent tooling, instructions and memory
#
# These hold development process notes and machine-specific configuration
# rather than product code.
# -----------------------------------------------------------------------------
.agent/
.claude/
.codex/

# -----------------------------------------------------------------------------
# Graphify
#
# The shareable code graph is committed on purpose so the repository can be
# navigated without regenerating it. Everything below is machine-specific:
# caches, personal query memory, cost tracking, and dated backup snapshots.
# -----------------------------------------------------------------------------
graphify-out/cache/
graphify-out/cost.json
graphify-out/memory/
graphify-out/reflections/
graphify-out/.graphify_*
graphify-out/????-??-??/
