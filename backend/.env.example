APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
FRONTEND_ORIGIN=http://localhost:5173
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
LLM_API_KEY=
TESSERACT_CMD=tesseract

# Comma-separated additional origins allowed to call this API.
# localhost:5173 and 127.0.0.1:5173 are always enabled for local development.
CORS_ALLOW_ORIGINS=

# Scheme Navigator AI explainer. Leave blank to use the deterministic fallback.
# Placeholder only - put the real key in backend/.env, which is gitignored.
GROQ_API_KEY=
EXPLAINER_MODEL=openai/gpt-oss-120b
