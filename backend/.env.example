APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
FRONTEND_ORIGIN=http://localhost:5173
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Comma-separated additional origins allowed to call this API.
# localhost:5173 and 127.0.0.1:5173 are always enabled for local development.
CORS_ALLOW_ORIGINS=

# Supabase Auth. Access tokens are verified locally against the JWT secret
# (HS256) or the project's published JWKS; the remote /auth/v1/user check is
# only a fallback. For local Supabase, `supabase status` prints the default
# JWT_SECRET - copy it into SUPABASE_JWT_SECRET.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Scheme Navigator AI assistant, powered by Google Gemini. Leave
# GEMINI_API_KEY blank and the explainer and chatbot degrade to their
# deterministic answers rather than failing, so the core journey never
# depends on the model.
# Placeholder only - put the real key in backend/.env, which is gitignored.
GEMINI_API_KEY=
# gemini-flash-latest looks like the obvious choice but is known to hang
# indefinitely on generateContent -- use gemini-3.6-flash instead.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
